# ============================================================
# UrbanPulse Ingestion API — Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env files with real secrets to version control.
# ============================================================

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/urbanpulse
DB_POOL_MIN=2
DB_POOL_MAX=10

# --- Authentication (REQUIRED — server will not start without JWT_SECRET_KEY) ---
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET
JWT_EXPIRATION_MINUTES=480
JWT_ALGORITHM=HS256

# --- Bootstrap Admin (optional — creates admin on first startup if no admin exists) ---
# BOOTSTRAP_ADMIN_EMAIL=admin@urbanpulse.local
# BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
# BOOTSTRAP_ADMIN_NAME=System Administrator

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006

# --- Rate Limiting ---
LOGIN_RATE_LIMIT_PER_MINUTE=10

# --- S3 / MinIO ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=urbanpulse-images
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# --- Redis Queue ---
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=detection_jobs

# --- Image Processing ---
MAX_IMAGE_SIZE_MB=20

# --- Blur Pipeline ---
BLUR_ENABLED=true
BLUR_MODE=stub

# --- Detection ---
CONFIDENCE_THRESHOLD=0.4

# --- Server ---
HOST=0.0.0.0
PORT=8001
DEBUG=false
